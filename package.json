{
  "name": "riyadh-metro-navigator",
  "version": "1.0.0",
  "description": "Riyadh public transport navigator: metro (6 lines, 83 stations) + Riyadh Bus (88 routes, 3,010 stops) with a multimodal journey planner, district maps, park & ride, KML/KMZ/GeoJSON/GPX/CSV and a GTFS feed.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "test:dom": "node --test test/dom.test.js",
    "serve": "node scripts/serve.js",
    "start": "node scripts/serve.js",
    "route": "node scripts/route.js",
    "validate": "node scripts/build.js --check",
    "import:transit": "node scripts/import-transit.js"
  },
  "keywords": [
    "bus-map",
    "geojson",
    "google-earth",
    "google-maps",
    "gtfs",
    "journey-planner",
    "kml",
    "kmz",
    "metro",
    "park-and-ride",
    "public-transport",
    "riyadh",
    "riyadh-bus",
    "saudi-arabia",
    "transit"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/engmohammeda/RiyadhMetro-.git"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2"
  }
}